{
  "name": "@tech-inject/cli",
  "version": "0.1.0",
  "description": "Install Tech Inject Design Library components into your project.",
  "type": "module",
  "bin": { "tech-inject": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tech-inject/eslint-config": "workspace:*",
    "@tech-inject/shared": "workspace:*",
    "@tech-inject/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "eslint": "^8.57.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
