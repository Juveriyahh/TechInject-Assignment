{
  "name": "@tech-inject/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./types": "./src/types.ts",
    "./testing": "./src/testing/fake-supabase.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed:rest": "tsx scripts/seed-rest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tech-inject/eslint-config": "workspace:*",
    "@tech-inject/tsconfig": "workspace:*",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
