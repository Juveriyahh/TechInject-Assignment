# Shared secret guarding every admin write endpoint and the admin dashboard session.
ADMIN_SECRET=replace-with-a-long-random-string

# Server-only Supabase credentials (never exposed to the browser bundle).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Postgres connection string used by the migration and seed runners.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Private bucket holding uploaded component bundles.
SUPABASE_STORAGE_BUCKET=component-bundles

# Public (anon) credentials, safe for the browser. Used by the Phase 2 catalogue.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_TELEMETRY_DISABLED=1

# Password given to every seeded account by `pnpm db:seed` (catalogue login).
SEED_PASSWORD=TechInject!2026

# Base URL the CLI installer fetches components from.
TECH_INJECT_REGISTRY_URL=http://localhost:3000
